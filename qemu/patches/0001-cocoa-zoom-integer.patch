+/*
+ * Called while the user drags the window edge with zoom-integer on: snap the
+ * proposed frame to the nearest whole-number zoom of the guest screen.
+ */
+- (NSSize) snapFrameSize:(NSSize)frameSize
+{
+    NSWindow *win = [self window];
+    CGFloat b = [self backingScale];
+    NSRect content = [win contentRectForFrameRect:
+                          NSMakeRect(0, 0, frameSize.width, frameSize.height)];
+    CGFloat k = MIN(content.size.width * b / screen.width,
+                    content.size.height * b / screen.height);
+
+    zoom_integer_scale = MIN(MAX(1, (int)lround(k)), [self maxIntegerScale]);
+    content.size = NSMakeSize(screen.width * zoom_integer_scale / b,
+                              screen.height * zoom_integer_scale / b);
+    return [win frameRectForContentRect:content].size;
 }
 
