+/*
+ * Place this view inside its container, the window's content view.  Without
+ * zoom-integer it fills the container.  With it, the guest screen is drawn at
+ * the largest whole-number zoom that fits, centred on device pixels, and the
+ * container paints the border black.
+ */
+- (void) layoutInSuperview
+{
+    NSView *container = [self superview];
+    NSRect area;
+    NSRect frame;
+    CGFloat b;
+    int k;
+
+    if (!container) {
+        return;
+    }
+
+    area = [container bounds];
+    if (!zoom_integer) {
+        [self setFrame:area];
+        [self updateBounds];
+        return;
+    }
+
+    if (@available(macOS 11.0, *)) {
+        area = [container safeAreaRect];
     }
+    b = [self backingScale];
+    k = [self integerScaleForSize:area.size];
+    frame.size = NSMakeSize(screen.width * k / b, screen.height * k / b);
+    frame.origin.x = area.origin.x +
+        floor((area.size.width - frame.size.width) * b / 2) / b;
+    frame.origin.y = area.origin.y +
+        floor((area.size.height - frame.size.height) * b / 2) / b;
+    [self setFrame:frame];
+    [self updateBounds];
+    [container setNeedsDisplay:YES];
+}
