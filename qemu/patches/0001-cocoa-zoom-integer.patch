+/* Largest whole-number zoom at which the guest screen fits in size (points). */
+- (int) integerScaleForSize:(NSSize)size
+{
+    CGFloat b = [self backingScale];
+    int kx = (int)floor(size.width * b / screen.width);
+    int ky = (int)floor(size.height * b / screen.height);
+
+    return MAX(1, MIN(kx, ky));
+}
+
+/* Largest whole-number zoom whose window still fits on the current screen. */
+- (int) maxIntegerScale
+{
+    NSWindow *win = [self window];
+    NSScreen *scr = [win screen] ? [win screen] : [NSScreen mainScreen];
+    NSRect content = [win contentRectForFrameRect:[scr visibleFrame]];
+
+    return [self integerScaleForSize:content.size];
+}
