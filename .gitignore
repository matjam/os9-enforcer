# Only our own scripts and patches are tracked. Third-party trees are
# fetched and built by scripts (qemu/build.sh) or cloned (see "Reference
# sources" in the README). The Mac programs are in os9-enforcer.

/disks/
/media/
# run/ holds guest logs, screenshots, sockets and memory dumps.
/run/
# qemu/build.sh downloads the release tarball, unpacks and patches it in
# qemu/src, and builds in qemu/build.
/qemu/src/
/qemu/src.part/
/qemu/build/
/qemu/*.tar.*
/toolchain/
/refs/
/tools/*/build/

__pycache__/

# Binary files, wherever they are.
*.bin
*.img
*.iso
*.dmg
*.qcow2
*.o
*.a
*.xcoff
*.pef
*.png
*.tar.*
*.part
.DS_Store
