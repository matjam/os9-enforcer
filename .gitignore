# Only our own sources and scripts are tracked. The toolchain, QEMU and the
# disk images live in os9-protect.

# Build output (./build.sh builds each program in PROGRAM/build).
/*/build/
/*/build-*/

# Apple's Mac OS ROM file and the kernel taken from it (kernel/extract.sh).
/kernel/stock/

__pycache__/

# Binary files, wherever they are.
*.bin
*.img
*.dsk
*.o
*.a
*.xcoff
*.pef
*.png
.DS_Store
